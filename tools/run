#!/bin/sh
# Run a tool that works on repo files, in the image from tools/Dockerfile:
#   tools/run check-cards
#   tools/run card-image cards/website
# The image is built on first use and rebuilt when tools/Dockerfile changes.
# Docker is the only requirement.

set -eu

root=$(cd "$(dirname "$0")/.." && pwd)

if [ $# -eq 0 ]; then
  echo "usage: tools/run <tool> [args...]" >&2
  echo "tools: $(cd "$root/tools" && ls *.py | sed 's/\.py$//' | grep -v '^check-env$' | tr '\n' ' ')" >&2
  exit 2
fi

tool=$1
shift

if [ "$tool" = check-env ]; then
  echo "check-env checks the machine a card runs on, so it runs outside a container:" >&2
  echo "  python3 tools/check-env.py $*" >&2
  exit 2
fi

if [ ! -f "$root/tools/$tool.py" ]; then
  echo "no tool tools/$tool.py" >&2
  exit 2
fi

# The tag follows the Dockerfile, so an edit to it builds a new image.
tag="edgible-cards-tools:$(cksum < "$root/tools/Dockerfile" | cut -d ' ' -f 1)"
if ! docker image inspect "$tag" > /dev/null 2>&1; then
  echo "building $tag (first use)" >&2
  docker build --quiet --tag "$tag" - < "$root/tools/Dockerfile" > /dev/null
fi

# Run from the same directory under the repo, so relative paths still work.
case "$PWD/" in
  "$root"/*) here=${PWD#"$root"} ;;
  *) echo "run tools/run from inside the repo" >&2; exit 2 ;;
esac

# As the calling user, so files a tool writes are not owned by root on Linux.
exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp \
  --volume "$root:/repo" \
  --workdir "/repo$here" \
  "$tag" python "/repo/tools/$tool.py" "$@"
