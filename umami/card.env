# Settings for the umami card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place umami.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Umami. umami and analytics are one process. The container port stays 3000.
UMAMI_PORT=3000

# Umami database password. Generate with: openssl rand -hex 16
UMAMI_DB_PASSWORD=

# Signs Umami's sessions. Generate with: openssl rand -base64 32
UMAMI_APP_SECRET=

# Encrypts two-factor secrets. Generate with: openssl rand -hex 32
UMAMI_TWO_FACTOR_KEY=

# The admin's new password, set by prepare.sh in place of the default `umami`. Generate with: openssl rand -hex 16
UMAMI_ADMIN_PASSWORD=
