# Settings for the assistant card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place desk. Both apps run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the chat UI. The website card already uses 8080.
# The container port inside Open WebUI stays 8080.
ASSISTANT_PORT=8088

# Host port for Ollama. The container port stays 11434.
OLLAMA_PORT=11434
