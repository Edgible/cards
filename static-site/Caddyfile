# Caddy for the static-site card: plain HTTP on 8080. Edgible gives the site its hostname
# and HTTPS, so Caddy gets no certificate of its own, and its admin API is off.
{
	admin off
	auto_https off
}

:8080 {
	# current/ is the live version; sync.sh switches it to a new one in a single step.
	root * /srv/current
	encode zstd gzip
	file_server

	# Fonts and images change rarely; pages are always checked again.
	@assets path *.woff2 *.woff *.svg *.png *.jpg *.webp *.ico
	header @assets Cache-Control "public, max-age=604800"
	header ?Cache-Control "public, max-age=300"

	# A path that is no file or folder. With STATIC_SITE_FALLBACK set, such as /index.html
	# for a single-page app, that page answers with 200, and the app routes the path itself.
	# Otherwise the site's own 404.html answers, when it has one.
	handle_errors 404 {
		@fallback expression `{env.STATIC_SITE_FALLBACK} != ""`
		handle @fallback {
			rewrite * {env.STATIC_SITE_FALLBACK}
			file_server {
				status 200
			}
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}
