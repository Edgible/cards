# Settings for the accounts card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place identity. accounts and accounts-admin run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
IDENTITY_DEVICE=

# Host port for the sign-in pages and OIDC. The container port stays 3001.
ACCOUNTS_PORT=3011

# Host port for the Logto console. The container port stays 3002.
ACCOUNTS_ADMIN_PORT=3012

# Logto database password. Generate with: openssl rand -hex 16
LOGTO_DB_PASSWORD=

# Public URL of the accounts hostname, with https://.
# Leave empty for the first start. `edgible app list` prints it after Publish.
LOGTO_ENDPOINT=

# Public URL of the accounts-admin hostname, with https://.
# Leave empty for the first start. `edgible app list` prints it after Publish.
LOGTO_ADMIN_ENDPOINT=
