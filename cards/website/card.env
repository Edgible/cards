# Settings for the website card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place web. site, strapi, analytics, and umami run on this device.
# The name is the one `edgible device list` prints. The Compose files do not read this.
WEB_DEVICE=

# Serving device for place monitor. status runs on this device.
# Use the same name as WEB_DEVICE when both places are one machine.
MONITOR_DEVICE=

# Host port for the React site. The container port stays 3000.
SITE_PORT=8080

# Host port for the Strapi editor. The container port stays 1337.
STRAPI_PORT=1337

# Strapi database password. Generate with: openssl rand -hex 16
STRAPI_DATABASE_PASSWORD=

# Comma-separated. Generate two values with: openssl rand -base64 16
APP_KEYS=

# Generate each with: openssl rand -base64 32
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Host port for Umami. analytics and umami are one process.
UMAMI_PORT=3000

# Host port for Uptime Kuma.
STATUS_PORT=3001

# Umami database password. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
APP_SECRET=

# Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=
