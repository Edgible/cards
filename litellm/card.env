# Settings for the litellm card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place lab. Both apps run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port. The container port stays 4000.
LITELLM_PORT=4000

# Database password. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Root credential for the gateway. It is also the Admin UI password.
# The username in the Admin UI is admin.
# Generate with: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# Encrypts provider keys stored in the database. Keep the value you generate.
# Changing it later makes those stored keys unreadable.
# Generate with: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_SALT_KEY=
