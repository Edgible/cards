# Settings for the mcp-bridge card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place mcp-bridge.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for mcp-bridge. The container port stays 8000.
MCP_BRIDGE_PORT=8000

# The command that runs your MCP server over stdio, with an exact version.
# npm: npx -y <package>@<version> [args]    PyPI: uvx <package>==<version> [args]
# The default is the MCP project's test server, which shows every feature of the protocol.
MCP_BRIDGE_COMMAND="npx -y @modelcontextprotocol/server-everything@2026.8.31"
