# Settings for the minecraft card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place minecraft.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Read the Minecraft End User License Agreement, https://www.minecraft.net/eula,
# and set this to TRUE to accept it. The server does not start until you do.
MINECRAFT_EULA=

# Host port for Java Edition. A TCP app's port is from 20000 to 29999. The container port stays 25565.
MC_JAVA_PORT=25565

# Host port for Bedrock Edition. A UDP app's port is from 20000 to 29999. The container port stays 19132.
MC_BEDROCK_PORT=29132

# The message players see in their server list.
MINECRAFT_MOTD="Game night"
